{
  "name": "gst-vendor-mailer-pro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Rich React + Node app for vendor-wise GST reconciliation statements & bulk mailing",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "NODE_ENV=production node server/index.js",
    "postinstall": "npm --prefix web install --no-audit --no-fund"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
